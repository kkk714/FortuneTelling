  "components": {
    "schemas": {
      "Biography": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "url",
          "available"
        ],
        "title": "Biography"
      },
      "BirthInput": {
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "title": "Date",
            "examples": [
              "2003-04-01"
            ]
          },
          "time": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$",
            "title": "Time",
            "examples": [
              "14:15"
            ]
          },
          "timezone": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Timezone",
            "default": "Asia/Shanghai"
          },
          "fold": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fold",
            "description": "仅重复钟点需要：0 为第一次，1 为第二次。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "time"
        ],
        "title": "BirthInput"
      },
      "BirthRequest": {
        "properties": {
          "birth": {
            "$ref": "#/components/schemas/BirthInput"
          },
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "title": "Language",
            "default": "zh"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "birth"
        ],
        "title": "BirthRequest"
      },
      "Chart": {
        "properties": {
          "pillars": {
            "$ref": "#/components/schemas/Pillars"
          },
          "element_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Element Counts"
          }
        },
        "type": "object",
        "required": [
          "pillars",
          "element_counts"
        ],
        "title": "Chart"
      },
      "ChartResponse": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "title": "Language"
          },
          "birth": {
            "$ref": "#/components/schemas/ResolvedBirth"
          },
          "chart": {
            "$ref": "#/components/schemas/Chart"
          },
          "element_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Element Labels"
          },
          "calculation_note": {
            "type": "string",
            "title": "Calculation Note"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "language",
          "birth",
          "chart",
          "element_labels",
          "calculation_note",
          "notice"
        ],
        "title": "ChartResponse"
      },
      "CitiesResponse": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "title": "Language"
          },
          "cities": {
            "items": {
              "$ref": "#/components/schemas/City"
            },
            "type": "array",
            "title": "Cities"
          }
        },
        "type": "object",
        "required": [
          "language",
          "cities"
        ],
        "title": "CitiesResponse"
      },
      "City": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "timezone"
        ],
        "title": "City"
      },
      "DrawRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "wealth",
              "study",
              "romance"
            ],
            "title": "Topic",
            "default": "wealth"
          },
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "title": "Language",
            "default": "zh"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DrawRequest"
      },
      "DrawResponse": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "title": "Language"
          },
          "lot": {
            "$ref": "#/components/schemas/Lot"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "language",
          "lot",
          "notice"
        ],
        "title": "DrawResponse"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "api_version"
        ],
        "title": "HealthResponse"
      },
      "Lot": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "topic": {
            "type": "string",
            "enum": [
              "wealth",
              "study",
              "romance"
            ],
            "title": "Topic"
          },
          "topic_label": {
            "type": "string",
            "title": "Topic Label"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation"
          },
          "advice": {
            "type": "string",
            "title": "Advice"
          }
        },
        "type": "object",
        "required": [
          "id",
          "topic",
          "topic_label",
          "title",
          "text",
          "interpretation",
          "advice"
        ],
        "title": "Lot"
      },
      "PeopleRequest": {
        "properties": {
          "birth": {
            "$ref": "#/components/schemas/BirthInput"
          },
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "title": "Language",
            "default": "zh"
          },
          "limit": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "birth"
        ],
        "title": "PeopleRequest"
      },
      "PeopleResponse": {
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "title": "Language"
          },
          "birth": {
            "$ref": "#/components/schemas/ResolvedBirth"
          },
          "dominant_elements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dominant Elements"
          },
          "element_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Element Labels"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/PersonMatch"
            },
            "type": "array",
            "title": "People"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "language",
          "birth",
          "dominant_elements",
          "element_labels",
          "people",
          "notice"
        ],
        "title": "PeopleResponse"
      },
      "PersonInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "birth": {
            "type": "string",
            "title": "Birth"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "birth_source": {
            "type": "string",
            "title": "Birth Source"
          },
          "dominant_elements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dominant Elements"
          },
          "element_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Element Counts"
          }
        },
        "type": "object",
        "required": [
