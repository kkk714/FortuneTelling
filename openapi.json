            "title": "Title"
          },
          "basis": {
            "type": "string",
            "title": "Basis"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "advice": {
            "type": "string",
            "title": "Advice"
          }
        },
        "type": "object",
